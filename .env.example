# Server-side environment variables (NEVER expose to client)
# In Vercel, configure this in Project Settings -> Environment Variables.
# The client communicates with the /api/gemini serverless proxy.

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
